# Umami Analytics Configuration
# Copy this file to .env and fill in your Umami credentials

# For Umami Cloud:
VITE_UMAMI_BASE_URL=https://api.umami.is/v1
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_UMAMI_WEBSITE_ID=36518791-36f7-40b5-b2f8-c2f9067d129a
VITE_UMAMI_API_KEY=your-api-key-here

# For Self-Hosted Umami:
# VITE_UMAMI_BASE_URL=https://your-umami-domain.com/api
# VITE_UMAMI_SCRIPT_URL=https://your-umami-domain.com/script.js
# VITE_UMAMI_WEBSITE_ID=your-website-uuid-here
# VITE_UMAMI_API_KEY=your-bearer-token-here
